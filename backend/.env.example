# Copy to .env and fill in. Never commit .env.

PORT=4000

# Network interface to listen on. 127.0.0.1 = this machine only (default).
# Use 0.0.0.0 only behind an HTTPS reverse proxy, with COOKIE_SECURE=true.
HOST=127.0.0.1

# Comma-separated host names users open the app on, as the browser sends them (name, or name:port).
# localhost:PORT is always allowed. Required on a server, e.g. ALLOWED_HOSTS=dmauth.example.com
# Requests for any other name get 421 (blocks DNS rebinding).
ALLOWED_HOSTS=

# Your Metabase base URL (no trailing slash)
METABASE_URL=https://metabase.cloudfuze.com

# Random long string (32+ characters) used to sign the app's session cookie.
# The server refuses to start with a weak one when HOST lets other machines connect.
SESSION_SECRET=change-me-to-a-long-random-string

# Set to true when serving over HTTPS (also trusts the first proxy for client IPs)
COOKIE_SECURE=false

# Set when a reverse proxy is in front, so rate limits see real client IPs: true (one proxy), a hop
# count, or the proxy's address (e.g. loopback, 10.0.0.5). COOKIE_SECURE=true implies true.
# Leave false when clients connect directly: otherwise they can fake their IP.
TRUST_PROXY=false

# Server capacity (defaults suit a team server). Sessions and checks live in memory; a restart clears them.
# MAX_SESSIONS=2000        signed-in sessions kept (8 hours each; the least recently used goes first)
# MAX_RUNNING_CHECKS=8     checks running at once across all users (each user may run 2)
# JOBS_PER_SESSION=10      finished checks kept per session
# MAX_STORED_JOBS=200      finished checks kept in all (6 hours at most)

# Optional: use a Metabase API key instead of username/password login
# (needed if your Metabase only allows Google/SSO sign-in). Leave empty to use login.
METABASE_API_KEY=

# With METABASE_API_KEY, everyone signs in as the same Metabase user. Set a password here so
# the Connect button asks for it; required if HOST lets other machines reach the app (sign-in is refused without it).
APP_PASSWORD=

# Optional "Sign in with Microsoft" in front of the Metabase sign-in (leave MS_TENANT_ID empty to turn it off).
# Create an app registration in Entra ID (single tenant), add the Web redirect URI below, then copy these:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Only accounts ending @this-domain are let in
MS_ALLOWED_DOMAIN=cloudfuze.com
# Must match the registered redirect URI exactly. Default: http://localhost:PORT/api/auth/microsoft/callback
# On a server, set it to https://<your host>/api/auth/microsoft/callback (and add that host to ALLOWED_HOSTS).
MS_REDIRECT_URI=

# How long (ms) to wait for one Metabase query before giving up
METABASE_TIMEOUT_MS=120000

# How long (minutes) cached validation results are reused before re-checking
CACHE_TTL_MINUTES=60

# Parallel Slack auth.test calls (keep low to avoid rate limits; rate-limited calls are retried)
SLACK_CONCURRENCY=5
